class Solution:
    def maxLength(self, arr):
        # code here
        sum = 0
        n = len(arr)
        res = 0 
        mp = {}
        
        for i in range(n):
            sum += arr[i]
            
            if(sum == 0):
                res = max(res,i+1)
                continue
            
            if sum not in mp:
                mp[sum] = i
            else:
                idx = mp[sum]
                length = i - idx
                res = max(res,length)
                
        return res
